// =============================================================================
// sort_rom.mem : пузырьковая сортировка 10 слов в RAM[0..9] по возрастанию
//                (беззнаково). Машинный код (двоичный), одна команда на строку.
//
// Регистры: R1 = i (верхняя граница внутреннего цикла, 9..1)
//           R2 = j (индекс в массиве)   R3 = a[j]   R4 = a[j+1]
//
// Формат строки:  op_rd_rs_rt_00 | op_rd_rs_imm5 | op_rd_imm8 | op_field11
// =============================================================================
01011_001_00001001   // 00: LDI   R1, 9            ; i = 9
01011_010_00000000   // 01: LDI   R2, 0            ; outer: j = 0
01000_000_010_001_00 // 02: CMP   R2, R1           ; inner: j - i
10011_00000001000    // 03: BHS   +8  (-> 12)      ; если j >= i, конец прохода
01101_011_010_00000  // 04: LOAD  R3, [R2+0]       ; R3 = a[j]
01101_100_010_00001  // 05: LOAD  R4, [R2+1]       ; R4 = a[j+1]
01000_000_100_011_00 // 06: CMP   R4, R3           ; a[j+1] - a[j]
10011_00000000010    // 07: BHS   +2  (-> 10)      ; a[j+1] >= a[j]: обмен не нужен
01110_100_010_00000  // 08: STORE R4, [R2+0]       ; a[j]   = старое a[j+1]
01110_011_010_00001  // 09: STORE R3, [R2+1]       ; a[j+1] = старое a[j]
01010_010_010_00001  // 10: ADDI  R2, R2, 1        ; no_swap: j++
01111_00000000010    // 11: JUMP  2                ; на inner
01010_001_001_11111  // 12: ADDI  R1, R1, -1       ; inner_done: i--
10001_11111110011    // 13: BNE   -13 (-> 1)       ; если i != 0, новый проход
10100_00000000000    // 14: HLT                    ; конец программы
