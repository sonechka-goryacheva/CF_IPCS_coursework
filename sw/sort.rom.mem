// ROM: sort.asm
// Формат: двоичный ($readmemb), одно 16-битное слово в строке; '@A' - смена адреса (hex)
01011_001_00001001   // 000: start: LDI R1, array+N-1
01011_010_00000000   // 001: outer: LDI R2, array
01000_000_010_001_00 // 002: inner: CMP R2, R1
10011_00000001000    // 003: BHS inner_done
01101_011_010_00000  // 004: LOAD R3, [R2+0]
01101_100_010_00001  // 005: LOAD R4, [R2+1]
01000_000_100_011_00 // 006: CMP R4, R3
10011_00000000010    // 007: BHS no_swap
01110_100_010_00000  // 008: STORE R4, [R2+0]
01110_011_010_00001  // 009: STORE R3, [R2+1]
01010_010_010_00001  // 00A: no_swap: ADDI R2, R2, 1
01111_00000000010    // 00B: JUMP inner
01010_001_001_11111  // 00C: ADDI R1, R1, -1
10001_11111110011    // 00D: BNE outer
10100_00000000000    // 00E: HLT
